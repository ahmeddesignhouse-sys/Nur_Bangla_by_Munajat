{
  "entities": {
    "QuranBookmark": {
      "title": "QuranBookmark",
      "description": "Bookmarked Quran Ayah with Arabic and translation text.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase user UID."
        },
        "surahNumber": {
          "type": "integer",
          "description": "Surah number (1-114)."
        },
        "ayahNumber": {
          "type": "integer",
          "description": "Ayah number within Surah."
        },
        "surahNameBn": {
          "type": "string",
          "description": "Bangla Surah name."
        },
        "arabicText": {
          "type": "string",
          "description": "Arabic verse text."
        },
        "banglaText": {
          "type": "string",
          "description": "Bangla translation text."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on update."
        }
      },
      "required": [
        "userId",
        "surahNumber",
        "ayahNumber",
        "surahNameBn",
        "arabicText",
        "banglaText",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "User preferences for language, theme, district, calculation method, and Quran reader.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase user UID."
        },
        "districtId": {
          "type": "string",
          "description": "Selected Bangladesh district ID."
        },
        "asrMethod": {
          "type": "string",
          "enum": ["HANAFI", "SHAFI"],
          "description": "Asr calculation juristic method."
        },
        "themeMode": {
          "type": "string",
          "enum": ["SYSTEM", "LIGHT", "DARK"],
          "description": "App theme mode."
        },
        "accentTheme": {
          "type": "string",
          "enum": ["ISLAMIC_GREEN", "ROYAL_BLUE", "GOLD", "MEDINA_TEAL", "DESERT_ROSE", "NIGHT_INDIGO"],
          "description": "Accent color theme."
        },
        "quranDarkMode": {
          "type": "boolean",
          "description": "Eye-comfort dark mode for Quran reader."
        },
        "quranFontSize": {
          "type": "integer",
          "description": "Quran reader font size in sp."
        },
        "prePrayerMinutes": {
          "type": "integer",
          "description": "Pre-prayer reminder lead minutes."
        },
        "languageCode": {
          "type": "string",
          "enum": ["bn", "en"],
          "description": "App display and Quran translation language code."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp on update."
        }
      },
      "required": [
        "userId",
        "districtId",
        "asrMethod",
        "themeMode",
        "accentTheme",
        "quranDarkMode",
        "quranFontSize",
        "prePrayerMinutes",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/QuranBookmark" },
      "description": "User-scoped Quran Ayah bookmarks."
    },
    "/users/{userId}/preferences/{prefId}": {
      "schema": { "$ref": "#/entities/UserPreferences" },
      "description": "User-scoped app preferences synced across devices."
    }
  }
}
